{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@repo/shared": [
        "../../packages/shared/dist/index.d.ts"
      ],
      "@/*": [
        "src/*"
      ]
    },
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts"
  ]
}